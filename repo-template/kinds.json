{
  "docs": {},
  "go": {
    "extensions": ["golang.go@0.56.1"],
    "settings": {
      "go.toolsManagement.autoUpdate": false,
      "go.toolsManagement.checkForUpdates": "off",
      "go.lintOnSave": "off"
    },
    "devcontainer": "kinds/go",
    "claude": {
      "extraKnownMarketplaces": {
        "novatrail": { "source": { "source": "directory", "path": "./spec/claude-plugins" } }
      },
      "enabledPlugins": { "gopls-lsp@novatrail": true }
    }
  },
  "typescript": {
    "extensions": ["biomejs.biome@3.8.1"],
    "settings": {
      "[typescript]": { "editor.defaultFormatter": "biomejs.biome" }
    },
    "toolchain": "kinds/typescript.Dockerfile"
  }
}
