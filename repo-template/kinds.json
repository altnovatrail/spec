{
  "docs": {},
  "go": {
    "extensions": ["golang.go@0.58.0"],
    "settings": {
      "go.toolsManagement.autoUpdate": false,
      "go.toolsManagement.checkForUpdates": "off",
      "go.lintOnSave": "off"
    },
    "devcontainer": "kinds/go",
    "claudePlugins": ["gopls-lsp"]
  },
  "typescript": {
    "extensions": ["biomejs.biome@3.8.1"],
    "settings": {
      "[typescript]": { "editor.defaultFormatter": "biomejs.biome" }
    },
    "toolchain": "kinds/typescript.Dockerfile"
  }
}
