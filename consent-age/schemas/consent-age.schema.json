{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altnovatrail.github.io/spec/consent-age/1/consent-age.schema.json",
  "title": "Table of the age of digital consent",
  "description": "The table of the age of digital consent by country, consent-age/consent-age.yaml (section 4 of the text of the part): the age of each country with the law that sets it, and the age of a country the table does not hold.",
  "type": "object",
  "properties": {
    "format": {
      "const": 1,
      "description": "The version of the part, the integer in consent-age/VERSION."
    },
    "outside_table": {
      "const": 18,
      "description": "The age of digital consent of a country the table does not hold: a parent gives consent for every learner under 18 there (R134)."
    },
    "countries": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/country"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/entry",
          "unevaluatedProperties": false,
          "description": "An age of the country, from a day on, with the law that sets it."
        },
        "minItems": 1,
        "description": "The entries of the country, by the day they apply from, the earliest first."
      },
      "minProperties": 1,
      "description": "The countries, by their codes of ISO 3166-1 alpha-2."
    }
  },
  "required": [
    "format",
    "outside_table",
    "countries"
  ],
  "unevaluatedProperties": false,
