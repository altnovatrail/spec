      "description": "A country, by its code of ISO 3166-1 alpha-2: one of the 249 codes ISO 3166-1 assigns officially, as the iso-codes project of Debian keeps them (data/iso_3166-1.json, commit d055275). A code ISO only reserves, such as UK or EL, is none."
    },
    "day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$",
      "description": "A day of the calendar in UTC, YYYY-MM-DD."
    },
    "entry": {
      "type": "object",
      "properties": {
        "age": {
          "type": "integer",
          "minimum": 13,
          "maximum": 18,
          "description": "The age of digital consent: from it on a learner gives consent themselves, below it a parent gives it."
        },
        "from": {
          "$ref": "#/$defs/day",
          "description": "The day from which the age applies; a day still to come is a law adopted and not yet applying."
        },
        "law": {
          "$ref": "#/$defs/words",
          "description": "The law, by its official title in its own language and its number in the official journal."
        },
        "provision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "The article, section or paragraph of the law, as the law writes it."
        },
        "quote": {
          "$ref": "#/$defs/words",
          "description": "The words of the provision that set the age, verbatim, in the language of the law; for an age that is GDPR's own, the words of its article 8(1)."
        },
        "source": {
          "type": "string",
          "pattern": "^https://[^ ]+$",
          "maxLength": 2000,
          "description": "The URL of the official text that was read: the official journal or the official database of the country's laws, or EUR-Lex."
        },
        "read": {
          "$ref": "#/$defs/day",
          "description": "The day the source was read."
        },
        "note": {
          "$ref": "#/$defs/words",
          "description": "What else the reader of the entry needs, in English."
        }
      },
      "required": [
        "age",
        "from",
        "law",
        "provision",
        "quote",
        "source",
        "read"
      ]
    },
    "words": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    }
  }
}
