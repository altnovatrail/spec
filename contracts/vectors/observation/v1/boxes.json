        {"answer_slots": [{"answer_slot": {"item": 1, "slot": 1}, "value": "8."}, {"answer_slot": {"item": 2, "slot": 1}, "value": "= 7"}, {"answer_slot": {"item": 2, "slot": 2}, "value": "5"}]},
        {"answer_slots": [{"answer_slot": {"item": 1, "slot": 1}, "value": "8"}, {"answer_slot": {"item": 2, "slot": 1}, "value": "7."}, {"answer_slot": {"item": 2, "slot": 2}, "value": "10/2"}]}
