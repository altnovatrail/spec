        {"answer_slots": [{"answer_slot": {"item": 1, "slot": 1}, "value": "8"}, {"answer_slot": {"item": 2, "slot": 1}, "value": "7"}, {"answer_slot": {"item": 2, "slot": 2}, "value": "5"}]},
        {"answer_slots": [{"answer_slot": {"item": 1, "slot": 1}, "value": "8"}, {"answer_slot": {"item": 2, "slot": 1}, "value": "7"}, {"answer_slot": {"item": 2, "slot": 2}, "value": "5"}]}
      ],
      "valid": [true, true],
      "joined": {"answer_slots": [{"answer_slot": {"item": 1, "slot": 1}, "value": "8"}, {"answer_slot": {"item": 2, "slot": 1}, "value": "7"}, {"answer_slot": {"item": 2, "slot": 2}, "value": "5"}]},
      "verdicts": [
        {"answer_slots": [{"verdict": "correct"}], "verdict": "correct"},
        {"answer_slots": [{"verdict": "correct"}, {"verdict": "correct"}], "verdict": "correct"}
      ]
    },
    {
