    {"line": [{"text": "47 ÷ 6 = "}, {"binding": "box", "check": {"kind": "number", "key": "7"}}, {"text": " r "}, {"binding": "box", "check": {"kind": "number", "key": "5", "trap_values": [{"value": "11", "trap": "remainder-too-big"}]}}]}
  ],
  "cases": [
