{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://altnovatrail.github.io/spec/format/0.1/manifest.schema.json",
  "title": "Manifest",
  "description": "The manifest of a trial module.",
  "type": "object",
  "properties": {
    "module_format_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "The format version the module is written in.",
      "x-open": true
    },
    "id": {
      "type": "string",
      "description": "The module's ID.",
      "x-open": true
    },
    "version": {
      "type": "string",
      "description": "The module's version.",
      "x-open": true
    },
    "title": {
      "type": "string",
      "description": "What the module is called.",
      "x-open": true
    }
  },
  "required": [
    "module_format_version",
    "title"
  ],
  "unevaluatedProperties": false
}
